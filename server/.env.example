# Copy to .env and fill in. Nothing here is required except what you want to use.
#
# Where the database lives (one SQLite file: memories, skills, jobs, events, settings).
JARVIS_DATA=./data

# Shared secret. When set, the app must send it as  X-Jarvis-Token  on every /api call.
# Leave empty ONLY while you test on localhost / your own Wi-Fi.
JARVIS_TOKEN=

# Any OpenAI-compatible endpoint. This default is Google's Gemini compatibility API.
JARVIS_LLM_BASE=https://generativelanguage.googleapis.com/v1beta/openai
JARVIS_LLM_KEY=
JARVIS_LLM_MODEL=gemini-2.0-flash

# Optional: enable vector search on top of the built-in keyword search (needs a key above).
JARVIS_EMBED_MODEL=

# Background learner: how often it looks for work, and how many tries a bad job gets.
JARVIS_LEARNER=1
JARVIS_LEARNER_INTERVAL=15
JARVIS_LEARNER_TRIES=3

# Affect: hours for the mood to decay halfway back to calm.
JARVIS_AFFECT_HALFLIFE=6
